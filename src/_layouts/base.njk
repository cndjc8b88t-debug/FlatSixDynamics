<!doctype html>
<html lang="{{ pageLang or site.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0e1116">
    {# metaTitle in front matter overrides the <title> without touching the page heading. #}
    {% set pageTitle %}{% if metaTitle %}{{ metaTitle }}{% elif title %}{{ title }} — {{ site.title }}{% else %}{{ site.seoTitle or site.title }}{% endif %}{% endset %}
    {% set pageDescription = description or site.tagline %}
    {% set pageUrl = site.baseUrl + page.url %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <link rel="canonical" href="{{ pageUrl }}">
    {% if noindex %}<meta name="robots" content="noindex">{% endif %}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    {# Campaign landing pages (/go/) set smartBanner: false, so the banner does not bypass their campaign link. #}
    {% if smartBanner !== false %}<meta name="apple-itunes-app" content="app-id={{ site.appStoreId }}">{% endif %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:locale" content="{% if pageLang == 'de' %}de_DE{% else %}en_US{% endif %}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:image" content="{{ site.baseUrl }}{{ site.ogImage }}">
    <meta property="og:image:width" content="{{ site.ogImageWidth }}">
    <meta property="og:image:height" content="{{ site.ogImageHeight }}">
    <meta property="og:image:alt" content="{{ site.ogImageAlt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="{{ site.xHandle }}">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ site.baseUrl }}{{ site.ogImage }}">
    <meta name="twitter:image:alt" content="{{ site.ogImageAlt }}">
    {% if page.url == "/" %}{% include "jsonld.njk" %}{% endif %}
    <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
    {% include "header.njk" %}

    <main>
        {{ content | safe }}
    </main>

    {% include "footer.njk" %}
</body>
</html>
