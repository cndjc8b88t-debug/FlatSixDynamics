{#- Structured data for the home page. Brand only, no person.
    downloadUrl and sameAs use the plain App Store URL (no campaign token), so the
    identifier stays stable. Visible links keep appStoreUrlWebsite.
    applicationCategory and minimum iOS follow the live listing (Education, iOS 18.0; Juergen 13.11.2026,
    Tate K-3). If the category changes in ASC, change it here the same day. No rating.
    Price 0, no in-app purchase: the IAP is off sale since 2.0.2. -#}
{%- set ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": site.baseUrl + "/#organization",
      "name": site.title,
      "url": site.baseUrl + "/",
      "logo": site.baseUrl + site.logo,
      "email": site.contactEmail,
      "sameAs": [site.instagramUrl, site.xUrl, site.youtubeUrl, site.appStoreUrl]
    },
    {
      "@type": "WebSite",
      "@id": site.baseUrl + "/#website",
      "name": site.title,
      "url": site.baseUrl + "/",
      "inLanguage": "en-US",
      "publisher": { "@id": site.baseUrl + "/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": site.baseUrl + "/#app",
      "name": site.title,
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "iOS 18.0 or later",
      "description": "The airflow around a sports car, live on your iPhone. Drag the speed up to 400 km/h, switch spoiler, rear wing and ride height, or bring in your own car from a photo, and watch the air answer.",
      "url": site.baseUrl + "/",
      "image": site.baseUrl + site.ogImage,
      "downloadUrl": site.appStoreUrl,
      "installUrl": site.appStoreUrl,
      "sameAs": [site.appStoreUrl],
      "offers": { "@type": "Offer", "price": 0, "priceCurrency": "USD" },
      "publisher": { "@id": site.baseUrl + "/#organization" }
    }
  ]
} -%}
<script type="application/ld+json">{{ ld | dump | safe }}</script>
